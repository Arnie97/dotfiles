#!/bin/sh

if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

target="${1:-.}"
if [ -x "$(command -v findmnt)" ] && findmnt -T "$target" -O +noexec; then
    exit 1
fi

set -e
mount -vt proc proc "$target/proc"
mount -vt sysfs sys "$target/sys"
mount -vt tmpfs tmp "$target/tmp"
mount -v --bind /dev "$target/dev"
mount -v --bind /dev/pts "$target/dev/pts"
set +e

if [ "$#" -gt 0 ]; then
    shift
fi

if [ "$#" -eq 0 ] && [ "$SHELL" ] && [ ! -x "$target/$SHELL" ]; then
    echo '$SHELL "'$SHELL'" is not executable, fallback to /bin/sh'
    unset SHELL
fi

chroot "$target" "$@"

umount -v "$target/dev/pts" "$target/dev" "$target/tmp" "$target/sys" "$target/proc"
